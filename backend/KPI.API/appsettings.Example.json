{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<password>;SslMode=Require;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "<random secret, 32+ characters>",
    "Issuer": "kpi-management",
    "Audience": "kpi-management"
  },
  "Resend": {
    "ApiKey": "<resend api key>",
    "From": "KPI System <noreply@your-verified-domain.com>"
  },
  "App": {
    "BaseUrl": "https://<your-frontend-host>"
  },
  "Email": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
