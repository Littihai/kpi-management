{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<password>;SslMode=Require;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "<random secret, 32+ characters>",
    "Issuer": "kpi-management",
    "Audience": "kpi-management"
  },
  "App": {
    "BaseUrl": "https://<your-frontend-host>"
  },
  "Email": {
    "Enabled": true
  },
  "Admin": {
    "Email": "",
    "Password": "",
    "FirstName": "System",
    "LastName": "Admin"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Issues": {
    "FirstResponseHours": 2,
    "ResolveHours": { "Critical": 4, "High": 24, "Medium": 72, "Low": 168 }
  },
  "PublicIssues": {
    "MaxPerWindow": 5,
    "WindowMinutes": 15,
    "MaxPerDay": 300,
    "MaxUploadMbPerDay": 300,
    "MaxPerAddressPerDay": 50,
    "MaxUploadMbPerAddressPerDay": 60
  },
  "Audit": {
    "RequestLogRetentionDays": 90,
    "AnonymousPerAddressPerMinute": 20,
    "AnonymousPerMinute": 300
  },
  "LoginThrottle": {
    "MaxFailuresPerAccount": 5,
    "MaxFailuresPerIp": 20,
    "WindowMinutes": 15,
    "ClientIpHeader": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
